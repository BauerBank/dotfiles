# ---- global defaults: everything except position ----
output "Lenovo Group Limited 0x403A Unknown" {
    mode 1920x1200@60.00
    scale 1
    alias $LAPTOP-PRIVATE
}

output "Samsung Display Corp. 0x4208 Unknown" {
    mode 1920x1200@60.003
    scale 1
    alias $LAPTOP-WORK
}

output "Seiko Epson Corporation EPSON PJ 0x01010101" {
    mode 1920x1080
    scale 1
    alias $BEAMER
}

output "Dell Inc. DELL U3425WE 2ZTH3Z3" {
    mode 3440x1440@120.000
    scale 1
    alias $DELL-PRIVAT
}

# ---- profiles: only positions ----
profile beamer {
    output $LAPTOP-PRIVATE position 0,0
    output $BEAMER position 1920,0
}

profile privat-work {
    output $DELL-PRIVAT position 0,0
    output $LAPTOP-WORK position 3440,0
}

profile privat {
    output $DELL-PRIVAT position 0,0
    output $LAPTOP-PRIVATE position 3440,0
}

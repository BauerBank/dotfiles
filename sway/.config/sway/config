# Sway config generated from Hyprland config

### MONITORS ###
# These are handled by kanshi

### Workspaces ###
# Workspace 1 stays on the internal laptop panel.
workspace 1 output eDP-1

### MY PROGRAMS ###
set $terminal ghostty
# set $fileManager ghostty -e yazi
set $fileManager nautilus
set $menu fuzzel
set $browser firefox
set $mailProgram thunderbird

### AUTOSTART ###
exec_always --no-startup-id killall -q waybar; waybar
exec_always --no-startup-id killall -q swaync; swaync
exec_always --no-startup-id killall -q hypridle; hypridle
exec_always --no-startup-id killall -q nm-applet; nm-applet --indicator
exec_always --no-startup-id killall -q kanshi; kanshi
exec_always --no-startup-id killall -q autotiling; autotiling

### Backround ###
# exec hyprpaper
# exec_always swaybg -i ~/.config/backgrounds/spiderman.JPG -m fill
# exec_always swaybg -i ~/.config/backgrounds/frog.png -m stretch
exec_always --no-startup-id killall -q swaybg; swaybg -i ~/.config/backgrounds/frogNO.png -m fill

### SCRIPTS ###
exec_always ~/.config/sway/scripts/lid_switch.sh

# Start polkit authentication agent
exec_always --no-startup-id killall -q polkit-gnome-authentication-agent-1; /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 &

### ENVIRONMENT VARIABLES ###
# Push the Wayland session identifiers into the D-Bus and systemd user
# activation environments, so D-Bus-/systemd-activated services (portals,
# notification daemons, etc.) can detect the compositor. Sway does not set
# XDG_CURRENT_DESKTOP itself, so it is assigned inline below.
# Session-wide toolkit vars (QT_QPA_PLATFORM, GDK_BACKEND, ...) live in
# ~/.config/environment.d/sway.conf so they also reach apps launched directly
# by sway.
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway XDG_SESSION_DESKTOP=sway XDG_SESSION_TYPE=wayland
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE
# When sway is launched from a tty (not via a systemd session), also push sway's
# whole environment into the systemd user manager so its services see it:
exec systemctl --user import-environment

### LOOK AND FEEL ###
# Gaps and borders
gaps inner 0
gaps outer 0
default_border pixel 2
client.focused #f9e2af #f9e2af #f9e2af #f9e2af #f9e2af
client.unfocused #4b4b4b #4b4b4b #4b4b4b #4b4b4b #4b4b4b

# Window layout
# workspace_layout 

### INPUT ###
input type:keyboard {
    xkb_layout de
}

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

input * {
    pointer_accel 0
}

### KEYBINDINGS ###
set $mod Mod4

# Program launchers
bindsym $mod+Return exec $terminal
bindsym $mod+c kill
bindsym $mod+Shift+e exit
bindsym $mod+f exec $fileManager
bindsym $mod+e exec $mailProgram
bindsym $mod+v floating toggle
bindsym $mod+space exec $menu
bindsym $mod+b exec $browser
bindsym $mod+p layout toggle split
bindsym $mod+g fullscreen toggle
bindsym $mod+Shift+z exec hyprlock

# screenshot
bindsym XF86SelectiveScreenshot exec sway-screenshot -m window
bindsym $mod+XF86SelectiveScreenshot exec sway-screenshot -m region
bindsym $mod+Shift+XF86SelectiveScreenshot exec sway-screenshot -m output

bindsym $mod+Shift+r reload

# Focus movement (vim keys)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Workspace switching
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+6 workspace 6
bindsym $mod+7 workspace 7
bindsym $mod+8 workspace 8
bindsym $mod+9 workspace 9
bindsym $mod+0 workspace 10

# Move focused window to workspace
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5
bindsym $mod+Shift+6 move container to workspace 6
bindsym $mod+Shift+7 move container to workspace 7
bindsym $mod+Shift+8 move container to workspace 8
bindsym $mod+Shift+9 move container to workspace 9
bindsym $mod+Shift+0 move container to workspace 10

# Move workspace to differt screen
bindsym $mod+Shift+h move workspace to output left; workspace output left
bindsym $mod+Shift+l move workspace to output right; workspace output right

# Scratchpad
bindsym $mod+s scratchpad show
bindsym $mod+Shift+s move scratchpad

# Mouse bindings
floating_modifier $mod

# Volume and brightness
bindsym XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl s 10%+
bindsym XF86MonBrightnessDown exec brightnessctl s 10%-

# Media keys
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioPause exec playerctl play-pause
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous

# Window rules
for_window [class=".*"] inhibit_idle fullscreen

# Lid Switch
set $laptop eDP-1
bindswitch --reload --locked lid:on output $laptop disable
bindswitch --reload --locked lid:off output $laptop enable
